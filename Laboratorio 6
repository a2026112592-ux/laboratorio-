#include <iostream>
#include <iomanip>

using namespace std;

int main() {
    int N;
    double suma = 0.0;

    // Validación de entrada para asegurar que N sea entero positivo
    do {
        cout << "Ingrese un numero entero positivo N: ";
        cin >> N;
        if (N <= 0) {
            cout << "El numero debe ser mayor a 0. Intente nuevamente.\n";
        }
    } while (N <= 0);

    // Cálculo de la suma de la serie
    for (int i = 1; i <= N; i++) {
        suma += 1.0 / i;
    }

    // Mostrar el resultado con precisión de 4 decimales
    cout << fixed << setprecision(4);
    cout << "El resultado de la suma de la serie S es: " << suma << endl;

    return 0;
}
