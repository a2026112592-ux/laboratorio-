#include <iostream>
#include <string>
#include <vector>

using namespace std;

bool EsPreguntaValida(string texto) {
    if (texto.length() == 0) {
        cout << "Error: La pregunta no puede estar vacia." << endl;
        return false;
    }

    if (texto.at(0) == ' ' || texto.at(texto.length() - 1) == ' ') {
        cout << "Error: No deje espacios innecesarios al inicio o al final." << endl;
        return false;
    }

    if (texto.substr(0, 1).compare(" ") == 0) {
        return false;
    }

    return true;
}

void SolicitarCantidad(int &cantidad) {
    do {
        cout << "Ingrese la cantidad de preguntas: ";
        cin >> cantidad;
        if (cantidad <= 0) {
            cout << "Error: Ingrese una cantidad mayor a 0." << endl;
        }
    } while (cantidad <= 0);
    
    cin.ignore();
}

void RegistrarPreguntas(vector<string> &preguntas, int cantidad) {
    string texto;
    for (int i = 0; i < cantidad; i++) {
        do {
            cout << "Pregunta " << i + 1 << ":" << endl;
            getline(cin, texto);
        } while (!EsPreguntaValida(texto));
        
        preguntas.push_back(texto);
    }
}

void MostrarPreguntas(vector<string> preguntas) {
    cout << "\n==== PREGUNTAS REGISTRADAS ====\n" << endl;
    for (size_t i = 0; i < preguntas.size(); i++) {
        cout << i + 1 << ". " << preguntas[i] << endl;
    }
}

int main() {
    int cantidad = 0;
    vector<string> preguntas;

    SolicitarCantidad(cantidad);
    RegistrarPreguntas(preguntas, cantidad);
    MostrarPreguntas(preguntas);

    return 0;
}
