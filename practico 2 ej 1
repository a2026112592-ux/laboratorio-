#include <iostream>
#include <string>

using namespace std;

int main() {
    string nombre;
    int edad;
    string carrera;
    int semestre;

    cout << "Ingrese el nombre completo del estudiante: ";
    getline(cin, nombre);

    cout << "Ingrese la edad: ";
    cin >> edad;
    cin.ignore(); // Limpiar el búfer del teclado

    cout << "Ingrese la carrera: ";
    getline(cin, carrera);

    cout << "Ingrese el semestre: ";
    cin >> semestre;

    cout << "\n--- DATOS REGISTRADOS DEL ESTUDIANTE ---\n";
    cout << "Nombre completo: " << nombre << endl;
    cout << "Edad: " << edad << endl;
    cout << "Carrera: " << carrera << endl;
    cout << "Semestre: " << semestre << endl;

    return 0;
}
